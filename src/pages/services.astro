
---
import BaseLayout from "../layouts/BaseLayout.astro";

const services = [
  {
    number: "01",
    title: "Discovery & Problem Definition",
    description: "Getting beneath the surface to understand the real challenge, ask better questions, and identify what matters most."
  },
  {
    number: "02",
    title: "Strategic Thinking & Decision Support",
    description: "Bringing structure to complexity, connecting evidence and insight, and helping leaders make thoughtful, informed decisions."
  },
  {
    number: "03",
    title: "Facilitation & Stakeholder Engagement",
    description: "Bringing people and perspectives together to build shared understanding and support better decisions."
  },
  {
    number: "04",
    title: "Change & Implementation",
    description: "Turning insight into action through practical planning, thoughtful change, and sustainable implementation."
  }
];
---

<BaseLayout
  title="Services | Causeway"
  description="Explore Causeway's services in discovery, decision support, facilitation, stakeholder engagement, and organizational change."
>
  <section class="services section">
    <div class="section-inner">
      <p class="eyebrow">How Causeway Helps</p>

      <h1>Make sense of the messy.<br />Move toward what matters.</h1>

      <div class="service-grid">
        {services.map((service) => (
          <article class="service">
            <span class="number">{service.number}</span>
            <h2>{service.title}</h2>
            <p>{service.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .service-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 65px 70px;
    margin-top: 75px;
  }

  .service {
    border-top: 1px solid var(--stone);
    padding-top: 28px;
  }

  .number {
    display: block;
    color: var(--coastal);
    font-family: "Playfair Display", serif;
    font-size: 64px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -2px;
    margin-bottom: 22px;
  }

  .service h2 {
    margin: 0 0 16px;
    font-family: "Playfair Display", serif;
    font-size: 28px;
    font-weight: 400;
    line-height: 1.3;
  }

  .service p {
    max-width: 440px;
    margin: 0;
    font-size: 16px;
    line-height: 1.8;
  }

  @media (max-width: 700px) {
    .service-grid {
      grid-template-columns: 1fr;
      gap: 48px;
      margin-top: 50px;
    }

    .number {
      font-size: 56px;
      margin-bottom: 18px;
    }

    .service h2 {
      font-size: 26px;
    }

    .service p {
      font-size: 15px;
    }
  }
</style>
