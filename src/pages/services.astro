
---
import BaseLayout from "../layouts/BaseLayout.astro";

const services = [
  {
    number: "01",
    title: "Discovery & Problem Definition",
    introduction:
      "Getting beneath the surface to understand the real challenge, ask better questions, and identify what matters most.",
    details: [
      "Organizational discovery and current-state assessments",
      "Problem identification and definition",
      "Root-cause analysis and systems thinking",
      "Environmental scanning and evidence gathering",
      "Opportunity identification and prioritization",
      "Research, synthesis, and insight development"
    ],
    outcome:
      "A clearer understanding of the challenge, its underlying causes, and where attention can make the greatest difference."
  },
  {
    number: "02",
    title: "Strategic Thinking & Decision Support",
    introduction:
      "Bringing structure to complexity, connecting evidence and insight, and helping leaders make thoughtful, informed decisions.",
    details: [
      "Strategic planning and priority setting",
      "Strategic and operational advisory",
      "Options analysis and evaluation",
      "Evidence-informed recommendations",
      "Business cases and investment rationale",
      "Risk, opportunity, and impact assessment",
      "Performance measurement and quality frameworks"
    ],
    outcome:
      "Greater clarity on available options, stronger decision-making, and a more deliberate path forward."
  },
  {
    number: "03",
    title: "Facilitation & Stakeholder Engagement",
    introduction:
      "Bringing people and perspectives together to build shared understanding, challenge assumptions, and support better decisions.",
    details: [
      "Executive and leadership team facilitation",
      "Stakeholder engagement and consultation",
      "Cross-functional collaboration",
      "Strategic and operational workshops",
      "Facilitated discovery and problem-solving",
      "Consensus-building and organizational alignment",
      "Workshop design and delivery"
    ],
    outcome:
      "Meaningful participation, stronger alignment, and decisions informed by diverse perspectives and lived experience."
  },
  {
    number: "04",
    title: "Change & Implementation",
    introduction:
      "Turning insight into action through practical planning, thoughtful change, and sustainable implementation.",
    details: [
      "Implementation planning and support",
      "Organizational change management",
      "Digital health strategy and enablement",
      "Technology adoption and workflow integration",
      "Service model and process improvement",
      "Implementation readiness and impact assessments",
      "Evaluation, performance monitoring, and continuous improvement"
    ],
    outcome:
      "More purposeful implementation, stronger adoption, and meaningful improvements that can be sustained over time."
  }
];
---

<BaseLayout
  title="Services | Causeway"
  description="Explore Causeway's services in discovery, strategic thinking, decision support, facilitation, stakeholder engagement, and organizational change."
>
  <section class="services">

    <!-- INTRODUCTION -->
    <div class="services-intro section">
      <div class="section-inner">
        <div class="intro-grid">
          <div class="intro-content">
            <p class="eyebrow">How Causeway Helps</p>

            <h1>Make sense of the messy.<br />Move toward what matters.</h1>

            <p>
              Every organization faces challenges that aren't always easy to
              define, untangle, or solve. Causeway helps make sense of
              complexity, bring the right perspectives together, and create
              the conditions for better decisions and meaningful change.
            </p>

            <p>
              From focused discovery and strategic guidance to facilitated
              collaboration and implementation support, each engagement is
              shaped around the organization's context, challenges, and
              desired outcomes.
            </p>
          </div>

          <div class="intro-image">
            <img
              src="/services-collaboration.jpg"
              alt="Colleagues collaborating in a welcoming, contemporary setting"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>

    <!-- SERVICES -->
    <div class="service-grid">
      {services.map((service, index) => (
        <article class={`service service-${index + 1}`}>
          <div class="service-inner">

            <span class="number">{service.number}</span>

            <h2>{service.title}</h2>

            <p class="service-introduction">
              {service.introduction}
            </p>

            <div class="service-details">
              <h3>How Causeway Can Help</h3>

              <ul>
                {service.details.map((detail) => (
                  <li>{detail}</li>
                ))}
              </ul>
            </div>

            <div class="service-outcome">
              <h3>What This Makes Possible</h3>
              <p>{service.outcome}</p>
            </div>

          </div>
        </article>
      ))}
    </div>

    <!-- CLIENT OUTPUTS -->
    <section class="outputs-section">
      <div class="outputs-inner">

        <div class="outputs-heading">
          <p class="eyebrow">What You Can Expect to Take Away</p>

          <h2>Practical outputs.<br />Clearer direction.</h2>

          <p>
            The value of an engagement should extend beyond the conversations
            themselves. Depending on the challenge and scope of the work,
            Causeway helps organizations develop tangible outputs that create
            clarity, support decisions, and make progress possible.
          </p>
        </div>

        <div class="outputs-grid">

          <article class="output-card">
            <span class="output-number">01</span>
            <h3>A clearer understanding of the problem</h3>
            <p>
              Get beneath the surface to understand what is really happening
              and what is driving the challenge.
            </p>
            <ul>
              <li>Discovery findings and insights</li>
              <li>Root-cause analysis</li>
              <li>A shared definition of the problem</li>
            </ul>
          </article>

          <article class="output-card">
            <span class="output-number">02</span>
            <h3>A structured way forward</h3>
            <p>
              Bring evidence, perspectives, and possibilities together to
              make informed choices about what comes next.
            </p>
            <ul>
              <li>Strategic recommendations</li>
              <li>Options analysis and decision frameworks</li>
              <li>Priorities and areas of opportunity</li>
            </ul>
          </article>

          <article class="output-card">
            <span class="output-number">03</span>
            <h3>Shared understanding and alignment</h3>
            <p>
              Make space for different perspectives, surface what matters,
              and create a stronger foundation for collective decisions.
            </p>
            <ul>
              <li>Stakeholder insights and feedback</li>
              <li>Documented discussions and decisions</li>
              <li>Areas of agreement and unresolved questions</li>
            </ul>
          </article>

          <article class="output-card">
            <span class="output-number">04</span>
            <h3>A practical plan for action</h3>
            <p>
              Translate decisions into meaningful next steps that
              organizations can put into practice and build on.
            </p>
            <ul>
              <li>Prioritized recommendations</li>
              <li>Implementation plans and roadmaps</li>
              <li>Measures to track progress and impact</li>
            </ul>
          </article>

        </div>

        <p class="outputs-note">
          Every engagement is different. Outputs are shaped around the
          organization's needs, the questions being explored, and the
          outcomes the work is intended to support.
        </p>

      </div>
    </section>

    <!-- APPROACH GROUNDED IN CURIOSITY -->
    <section class="collaboration-section">
      <div class="collaboration-grid">

        <div class="collaboration-image">
          <img
            src="/causeway-values.png"
            alt="Colleagues talking in a relaxed, contemporary meeting space with warm natural light"
            loading="lazy"
          />
        </div>

        <div class="collaboration-content">
          <p class="eyebrow">An Approach Grounded in Curiosity</p>

          <h2>Better decisions start with better questions.</h2>

          <p>
            Complex challenges rarely have straightforward answers.
            Meaningful progress begins with curiosity, a willingness to
            challenge assumptions, and an openness to perspectives that
            might otherwise be overlooked.
          </p>

          <p>
            The goal isn't simply to find an answer. It's to understand
            the problem well enough to make a decision that moves things
            in the right direction.
          </p>
        </div>

      </div>
    </section>

    <!-- CLOSING -->
    <section class="services-closing">
      <div class="closing-inner">
        <p class="eyebrow">A Thoughtful Approach</p>

        <h2>Not every challenge needs the same approach.</h2>

        <p>
          Causeway's services are not a prescribed sequence or a
          one-size-fits-all solution. Engagements can focus on a
          specific challenge or bring together several areas of
          expertise. The starting point is understanding the
          circumstances, the desired outcomes, and what will make
          the greatest difference.
        </p>

        <p class="closing-emphasis">
          The right next step starts with the right conversation.
        </p>
      </div>
    </section>

  </section>
</BaseLayout>

<style>
  /* INTRODUCTION */

  .services-intro {
    padding-top: 65px;
    padding-bottom: 75px;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: 75px;
  }

  .intro-content h1 {
    margin-bottom: 30px;
  }

  .intro-content > p:not(.eyebrow) {
    font-size: 17px;
    line-height: 1.9;
    margin-bottom: 20px;
  }

  .intro-image {
    height: 460px;
    overflow: hidden;
    border-radius: 3px;
  }

  .intro-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }


  /* SERVICE GRID */

  .service-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .service {
    padding: 65px 9%;
  }

  .service-inner {
    max-width: 560px;
    margin: 0 auto;
  }

  .service-1 {
    background: #F5F2EA;
  }

  .service-2 {
    background: #E9EEF0;
  }

  .service-3 {
    background: #EEECE5;
  }

  .service-4 {
    background: #E5EBE9;
  }

  .number {
    display: block;
    color: var(--coastal);
    font-family: "Playfair Display", serif;
    font-size: 68px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -2px;
    margin-bottom: 25px;
  }

  .service h2 {
    margin: 0 0 22px;
    font-family: "Playfair Display", serif;
    font-size: 30px;
    font-weight: 400;
    line-height: 1.3;
  }

  .service-introduction {
    margin: 0 0 38px;
    font-size: 17px;
    line-height: 1.85;
  }


  /* SERVICE DETAILS */

  .service-details h3,
  .service-outcome h3 {
    margin: 0 0 20px;
    color: var(--slate, #23364A);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.4px;
    line-height: 1.5;
  }

  .service-details ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .service-details li {
    position: relative;
    padding-left: 22px;
    margin-bottom: 14px;
    font-size: 17px;
    line-height: 1.75;
  }

  .service-details li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 12px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--coastal);
  }


  /* SERVICE OUTCOME */

  .service-outcome {
    border-top: 1px solid rgba(35, 54, 74, 0.2);
    margin-top: 35px;
    padding-top: 25px;
  }

  .service-outcome p {
    margin: 0;
    font-size: 17px;
    line-height: 1.85;
  }


  /* CLIENT OUTPUTS */

  .outputs-section {
    background: #F5F2EA;
    color: #23364A;
    padding: 90px 7%;
  }

  .outputs-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .outputs-heading {
    max-width: 760px;
    margin: 0 auto 55px;
    text-align: center;
  }

  .outputs-heading h2 {
    margin: 0 0 25px;
    font-family: "Playfair Display", serif;
    font-size: 38px;
    font-weight: 400;
    line-height: 1.35;
  }

  .outputs-heading > p:not(.eyebrow) {
    font-size: 17px;
    line-height: 1.85;
  }

  .outputs-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }

  .output-card {
    background: #FFFFFF;
    border: 1px solid rgba(35, 54, 74, 0.1);
    padding: 35px 38px;
  }

  .output-number {
    display: block;
    color: #668A9A;
    font-family: "Playfair Display", serif;
    font-size: 34px;
    line-height: 1;
    margin-bottom: 22px;
  }

  .output-card h3 {
    margin: 0 0 15px;
    color: #23364A;
    font-family: "Playfair Display", serif;
    font-size: 24px;
    font-weight: 400;
    line-height: 1.4;
  }

  .output-card > p {
    margin: 0 0 20px;
    font-size: 16px;
    line-height: 1.8;
  }

  .output-card ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .output-card li {
    position: relative;
    padding-left: 20px;
    margin-bottom: 10px;
    font-size: 15px;
    line-height: 1.7;
  }

  .output-card li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 11px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #668A9A;
  }

  .outputs-note {
    max-width: 850px;
    margin: 35px auto 0;
    color: #536474;
    font-size: 15px;
    line-height: 1.8;
    text-align: center;
    font-style: italic;
  }


  /* APPROACH GROUNDED IN CURIOSITY */

  .collaboration-section {
    background: #FFFFFF;
    color: #23364A;
    padding: 85px 7%;
  }

  .collaboration-grid {
    max-width: 1250px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 0.9fr;
    gap: 85px;
    align-items: center;
  }

  .collaboration-image {
    height: 410px;
    overflow: hidden;
    border-radius: 3px;
  }

  .collaboration-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .collaboration-content .eyebrow {
    color: #668A9A;
  }

  .collaboration-content h2 {
    margin: 0 0 25px;
    color: #23364A;
    font-family: "Playfair Display", serif;
    font-size: 36px;
    font-weight: 400;
    line-height: 1.35;
  }

  .collaboration-content > p:not(.eyebrow) {
    color: #23364A;
    font-size: 17px;
    line-height: 1.85;
    margin-bottom: 20px;
  }


  /* CLOSING SECTION */

  .services-closing {
    background: #23364A;
    color: #F5F2EA;
    padding: 90px 7%;
  }

  .closing-inner {
    max-width: 800px;
    margin: 0 auto;
  }

  .services-closing .eyebrow {
    color: #A8C0C7;
  }

  .services-closing h2 {
    max-width: 650px;
    margin: 0 0 25px;
    font-family: "Playfair Display", serif;
    font-size: 36px;
    font-weight: 400;
    line-height: 1.4;
  }

  .services-closing > .closing-inner > p:not(.eyebrow) {
    font-size: 17px;
    line-height: 1.9;
  }

  .services-closing .closing-emphasis {
    margin-top: 30px;
    color: #B7CDD2;
    font-family: "Playfair Display", serif;
    font-size: 24px;
    font-style: italic;
  }


  /* MOBILE */

  @media (max-width: 850px) {
    .intro-grid {
      grid-template-columns: 1fr;
      gap: 35px;
    }

    .intro-image {
      height: 350px;
    }

    .service {
      padding: 50px 8%;
    }

    .service h2 {
      font-size: 27px;
    }

    .outputs-section {
      padding: 70px 6%;
    }

    .outputs-grid {
      gap: 16px;
    }

    .output-card {
      padding: 28px 25px;
    }

    .collaboration-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .collaboration-image {
      height: 350px;
    }

    .collaboration-content h2 {
      font-size: 32px;
    }
  }

  @media (max-width: 600px) {
    .services-intro {
      padding-top: 40px;
      padding-bottom: 50px;
    }

    .intro-content > p:not(.eyebrow) {
      font-size: 16px;
    }

    .intro-image {
      height: 270px;
    }

    .service-grid {
      grid-template-columns: 1fr;
    }

    .service {
      padding: 45px 7%;
    }

    .number {
      font-size: 58px;
    }

    .service h2 {
      font-size: 27px;
    }

    .service-introduction {
      font-size: 16px;
    }

    .service-details h3,
    .service-outcome h3 {
      font-size: 16px;
    }

    .service-details li {
      font-size: 16px;
    }

    .service-outcome p {
      font-size: 16px;
    }

    .outputs-section {
      padding: 55px 7%;
    }

    .outputs-heading {
      margin-bottom: 35px;
    }

    .outputs-heading h2 {
      font-size: 30px;
    }

    .outputs-heading > p:not(.eyebrow) {
      font-size: 16px;
    }

    .outputs-grid {
      grid-template-columns: 1fr;
      gap: 15px;
    }

    .output-card {
      padding: 28px 25px;
    }

    .output-card h3 {
      font-size: 22px;
    }

    .output-card > p {
      font-size: 16px;
    }

    .output-card li {
      font-size: 15px;
    }

    .outputs-note {
      font-size: 14px;
    }

    .collaboration-section {
      padding: 55px 7%;
    }

    .collaboration-image {
      height: 260px;
    }

    .collaboration-content h2 {
      font-size: 29px;
    }

    .collaboration-content > p:not(.eyebrow) {
      font-size: 16px;
    }

    .services-closing {
      padding: 60px 7%;
    }

    .services-closing h2 {
      font-size: 29px;
    }

    .services-closing > .closing-inner > p:not(.eyebrow) {
      font-size: 16px;
    }

    .services-closing .closing-emphasis {
      font-size: 21px;
    }
  }
</style>
