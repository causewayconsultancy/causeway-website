
---
import BaseLayout from "../layouts/BaseLayout.astro";

const services = [
  {
    number: "01",
    title: "Discovery & Problem Definition",
    introduction:
      "Getting beneath the surface to understand the real challenge, ask better questions, and identify what matters most.",
    details: [
      "Organizational discovery and current-state assessments",
      "Problem identification and definition",
      "Root-cause analysis and systems thinking",
      "Environmental scanning and evidence gathering",
      "Opportunity identification and prioritization",
      "Research, synthesis, and insight development"
    ],
    outcome:
      "A clearer understanding of the challenge, its underlying causes, and where attention can make the greatest difference."
  },
  {
    number: "02",
    title: "Strategic Thinking & Decision Support",
    introduction:
      "Bringing structure to complexity, connecting evidence and insight, and helping leaders make thoughtful, informed decisions.",
    details: [
      "Strategic planning and priority setting",
      "Strategic and operational advisory",
      "Options analysis and evaluation",
      "Evidence-informed recommendations",
      "Business cases and investment rationale",
      "Risk, opportunity, and impact assessment",
      "Performance measurement and quality frameworks"
    ],
    outcome:
      "Greater clarity on available options, stronger decision-making, and a more deliberate path forward."
  },
  {
    number: "03",
    title: "Facilitation & Stakeholder Engagement",
    introduction:
      "Bringing people and perspectives together to build shared understanding, challenge assumptions, and support better decisions.",
    details: [
      "Executive and leadership team facilitation",
      "Stakeholder engagement and consultation",
      "Cross-functional collaboration",
      "Strategic and operational workshops",
      "Facilitated discovery and problem-solving",
      "Consensus-building and organizational alignment",
      "Workshop design and delivery"
    ],
    outcome:
      "Meaningful participation, stronger alignment, and decisions informed by diverse perspectives and lived experience."
  },
  {
    number: "04",
    title: "Change & Implementation",
    introduction:
      "Turning insight into action through practical planning, thoughtful change, and sustainable implementation.",
    details: [
      "Implementation planning and support",
      "Organizational change management",
      "Digital health strategy and enablement",
      "Technology adoption and workflow integration",
      "Service model and process improvement",
      "Implementation readiness and impact assessments",
      "Evaluation, performance monitoring, and continuous improvement"
    ],
    outcome:
      "More purposeful implementation, stronger adoption, and meaningful improvements that can be sustained over time."
  }
];
---

<BaseLayout
  title="Services | Causeway"
  description="Explore Causeway's services in discovery, strategic thinking, decision support, facilitation, stakeholder engagement, and organizational change."
>
  <section class="services">

    <!-- INTRODUCTION -->
    <div class="services-intro section">
      <div class="section-inner">
        <div class="intro-grid">
          <div class="intro-content">
            <p class="eyebrow">How Causeway Helps</p>

            <h1>Make sense of the messy.<br />Move toward what matters.</h1>

            <p>
              Every organization faces challenges that aren't always easy to
              define, untangle, or solve. Causeway helps make sense of
              complexity, bring the right perspectives together, and create
              the conditions for better decisions and meaningful change.
            </p>

            <p>
              From focused discovery and strategic guidance to facilitated
              collaboration and implementation support, each engagement is
              shaped around the organization's context, challenges, and
              desired outcomes.
            </p>
          </div>

          <div class="intro-image">
            <img
              src="/services-collaboration.jpg"
              alt="Colleagues collaborating in a welcoming, contemporary setting"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>

    <!-- THE CHALLENGES ORGANIZATIONS FACE -->
    <section class="challenges-section">
      <div class="challenges-inner">
        <div class="challenges-heading">
          <p class="eyebrow">Where the Work Often Begins</p>
          <h2>Sometimes the challenge is clear. Sometimes finding it is the work.</h2>
          <p>
            Organizations reach out to Causeway at different points in a
            challenge.<br />
            You might recognize one of these situations, or be working through something that is harder to put into words.
          </p>
        </div>

        <div class="challenges-grid">
          <article class="challenge-card">
            <h3>The problem isn't clear</h3>
            <ul>
              <li>Something isn't working, but there isn't agreement about why.</li>
              <li>Efforts are focused on symptoms rather than underlying causes.</li>
              <li>You know something needs to change, but aren't sure where to start.</li>
            </ul>
          </article>

          <article class="challenge-card">
            <h3>People aren't aligned</h3>
            <ul>
              <li>Different teams or stakeholders see the challenge in different ways.</li>
              <li>Competing priorities make it difficult to move forward.</li>
              <li>Decisions are being made without the perspectives of the people affected.</li>
            </ul>
          </article>

          <article class="challenge-card">
            <h3>Progress has stalled</h3>
            <ul>
              <li>Previous initiatives haven't delivered the outcomes you expected.</li>
              <li>Plans lose momentum between strategy and implementation.</li>
              <li>Time and resources are being invested without clarity on what will make the biggest difference.</li>
            </ul>
          </article>

          <article class="challenge-card">
            <h3>Change feels complex</h3>
            <ul>
              <li>New technology or processes aren't being adopted as intended.</li>
              <li>Operational challenges are affecting quality, performance, or service delivery.</li>
              <li>Important decisions need to be made with incomplete information.</li>
            </ul>
          </article>
        </div>

        <p class="challenges-note">
          These are starting points, not prerequisites. You don't need to
          have the problem figured out before reaching out. Helping you
          understand the challenge is part of the work.
        </p>
      </div>
    </section>

    <!-- SERVICES -->
    <div class="service-grid">
      {services.map((service, index) => (
        <article class={`service service-${index + 1}`}>
          <div class="service-inner">

            <span class="number">{service.number}</span>

            <h2>{service.title}</h2>

            <p class="service-introduction">
              {service.introduction}
            </p>

            <div class="service-details">
              <h3>How Causeway Can Help</h3>

              <ul>
                {service.details.map((detail) => (
                  <li>{detail}</li>
                ))}
              </ul>
            </div>

            <div class="service-outcome">
              <h3>What This Makes Possible</h3>
              <p>{service.outcome}</p>
            </div>

          </div>
        </article>
      ))}
    </div>

    <!-- APPROACH GROUNDED IN CURIOSITY -->
    <section class="collaboration-section">
      <div class="collaboration-grid">

        <div class="collaboration-image">
          <img
            src="/causeway-values.png"
            alt="Colleagues talking in a relaxed, contemporary meeting space with warm natural light"
            loading="lazy"
          />
        </div>

        <div class="collaboration-content">
          <p class="eyebrow">An Approach Grounded in Curiosity</p>

          <h2>Better decisions start with better questions.</h2>

          <p>
            Complex challenges rarely have straightforward answers.
            Meaningful progress begins with curiosity, a willingness to
            challenge assumptions, and an openness to perspectives that
            might otherwise be overlooked.
          </p>

          <p>
            The goal isn't simply to find an answer. It's to understand
            the problem well enough to make a decision that moves things
            in the right direction.
          </p>
        </div>

      </div>
    </section>

    <!-- CLOSING -->
    <section class="services-closing">
      <div class="closing-inner">
        <p class="eyebrow">A Thoughtful Approach</p>

        <h2>Not every challenge needs the same approach.</h2>

        <p>
          Causeway's services are not a prescribed sequence or a
          one-size-fits-all solution. Engagements can focus on a
          specific challenge or bring together several areas of
          expertise. The starting point is understanding the
          circumstances, the desired outcomes, and what will make
          the greatest difference.
        </p>

        <p class="closing-emphasis">
          The right next step starts with the right conversation.
        </p>
      </div>
    </section>

  </section>
</BaseLayout>

<style>
  /* INTRODUCTION */

  .services-intro {
    padding-top: 65px;
    padding-bottom: 75px;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: 75px;
  }

  .intro-content h1 {
    margin-bottom: 30px;
  }

  .intro-content > p:not(.eyebrow) {
    font-size: 17px;
    line-height: 1.9;
    margin-bottom: 20px;
  }

  .intro-image {
    height: 460px;
    overflow: hidden;
    border-radius: 3px;
  }

  .intro-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }


  /* ORGANIZATIONAL CHALLENGES */

  .challenges-section {
    background: #F5F2EA;
    padding: 85px 7%;
  }

  .challenges-inner {
    max-width: 1250px;
    margin: 0 auto;
  }

  .challenges-heading {
    max-width: 780px;
    margin-bottom: 45px;
  }

  .challenges-heading h2 {
    margin: 0 0 20px;
    color: #23364A;
    font-family: "Playfair Display", serif;
    font-size: 38px;
    font-weight: 400;
    line-height: 1.3;
  }

  .challenges-heading > p:not(.eyebrow) {
    margin: 0;
    color: #23364A;
    font-size: 17px;
    line-height: 1.85;
  }

  .challenges-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .challenge-card {
    background: #FFFFFF;
    padding: 32px 34px;
    border: 1px solid rgba(35, 54, 74, 0.09);
  }

  .challenge-card h3 {
    margin: 0 0 17px;
    color: #23364A;
    font-family: "Playfair Display", serif;
    font-size: 25px;
    font-weight: 400;
    line-height: 1.35;
  }

  .challenge-card ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .challenge-card li {
    position: relative;
    padding-left: 19px;
    margin-bottom: 12px;
    color: #23364A;
    font-size: 16px;
    line-height: 1.7;
  }

  .challenge-card li:last-child {
    margin-bottom: 0;
  }

  .challenge-card li::before {
    content: "";
    position: absolute;
    top: 11px;
    left: 0;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #668A9A;
  }

  .challenges-note {
    max-width: 900px;
    margin: 35px 0 0;
    color: #23364A;
    font-size: 16px;
    line-height: 1.8;
    font-style: italic;
  }


  /* SERVICE GRID */

  .service-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .service {
    padding: 65px 9%;
  }

  .service-inner {
    max-width: 560px;
    margin: 0 auto;
  }

  .service-1 {
    background: #F5F2EA;
  }

  .service-2 {
    background: #E9EEF0;
  }

  .service-3 {
    background: #EEECE5;
  }

  .service-4 {
    background: #E5EBE9;
  }

  .number {
    display: block;
    color: var(--coastal);
    font-family: "Playfair Display", serif;
    font-size: 68px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -2px;
    margin-bottom: 25px;
  }

  .service h2 {
    margin: 0 0 22px;
    font-family: "Playfair Display", serif;
    font-size: 30px;
    font-weight: 400;
    line-height: 1.3;
  }

  .service-introduction {
    margin: 0 0 38px;
    font-size: 17px;
    line-height: 1.85;
  }


  /* SERVICE DETAILS */

  .service-details h3,
  .service-outcome h3 {
    margin: 0 0 20px;
    color: var(--slate, #23364A);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.4px;
    line-height: 1.5;
  }

  .service-details ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .service-details li {
    position: relative;
    padding-left: 22px;
    margin-bottom: 14px;
    font-size: 17px;
    line-height: 1.75;
  }

  .service-details li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 12px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--coastal);
  }


  /* SERVICE OUTCOME */

  .service-outcome {
    border-top: 1px solid rgba(35, 54, 74, 0.2);
    margin-top: 35px;
    padding-top: 25px;
  }

  .service-outcome p {
    margin: 0;
    font-size: 17px;
    line-height: 1.85;
  }


  /* APPROACH GROUNDED IN CURIOSITY */

  .collaboration-section {
    background: #FFFFFF;
    color: #23364A;
    padding: 85px 7%;
  }

  .collaboration-grid {
    max-width: 1250px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 0.9fr;
    gap: 85px;
    align-items: center;
  }

  .collaboration-image {
    height: 410px;
    overflow: hidden;
    border-radius: 3px;
  }

  .collaboration-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .collaboration-content .eyebrow {
    color: #668A9A;
  }

  .collaboration-content h2 {
    margin: 0 0 25px;
    color: #23364A;
    font-family: "Playfair Display", serif;
    font-size: 36px;
    font-weight: 400;
    line-height: 1.35;
  }

  .collaboration-content > p:not(.eyebrow) {
    color: #23364A;
    font-size: 17px;
    line-height: 1.85;
    margin-bottom: 20px;
  }


  /* CLOSING SECTION */

  .services-closing {
    background: #23364A;
    color: #F5F2EA;
    padding: 90px 7%;
  }

  .closing-inner {
    max-width: 800px;
    margin: 0 auto;
  }

  .services-closing .eyebrow {
    color: #A8C0C7;
  }

  .services-closing h2 {
    max-width: 650px;
    margin: 0 0 25px;
    font-family: "Playfair Display", serif;
    font-size: 36px;
    font-weight: 400;
    line-height: 1.4;
  }

  .services-closing > .closing-inner > p:not(.eyebrow) {
    font-size: 17px;
    line-height: 1.9;
  }

  .services-closing .closing-emphasis {
    margin-top: 30px;
    color: #B7CDD2;
    font-family: "Playfair Display", serif;
    font-size: 24px;
    font-style: italic;
  }


  /* MOBILE */

  @media (max-width: 850px) {
    .intro-grid {
      grid-template-columns: 1fr;
      gap: 35px;
    }

    .intro-image {
      height: 350px;
    }

    .service {
      padding: 50px 8%;
    }

    .challenges-section {
      padding: 65px 7%;
    }

    .challenges-grid {
      gap: 16px;
    }

    .challenge-card {
      padding: 27px 25px;
    }

    .service h2 {
      font-size: 27px;
    }

    .collaboration-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .collaboration-image {
      height: 350px;
    }

    .collaboration-content h2 {
      font-size: 32px;
    }
  }

  @media (max-width: 600px) {
    .services-intro {
      padding-top: 40px;
      padding-bottom: 50px;
    }

    .intro-content > p:not(.eyebrow) {
      font-size: 16px;
    }

    .intro-image {
      height: 270px;
    }

    .service-grid {
      grid-template-columns: 1fr;
    }

    .challenges-section {
      padding: 55px 7%;
    }

    .challenges-heading h2 {
      font-size: 30px;
    }

    .challenges-heading > p:not(.eyebrow) {
      font-size: 16px;
    }

    .challenges-grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .challenge-card {
      padding: 26px 24px;
    }

    .challenge-card h3 {
      font-size: 23px;
    }

    .challenge-card li {
      font-size: 16px;
    }

    .challenges-note {
      font-size: 15px;
    }

    .service {
      padding: 45px 7%;
    }

    .number {
      font-size: 58px;
    }

    .service h2 {
      font-size: 27px;
    }

    .service-introduction {
      font-size: 16px;
    }

    .service-details h3,
    .service-outcome h3 {
      font-size: 16px;
    }

    .service-details li {
      font-size: 16px;
    }

    .service-outcome p {
      font-size: 16px;
    }

    .collaboration-section {
      padding: 55px 7%;
    }

    .collaboration-image {
      height: 260px;
    }

    .collaboration-content h2 {
      font-size: 29px;
    }

    .collaboration-content > p:not(.eyebrow) {
      font-size: 16px;
    }

    .services-closing {
      padding: 60px 7%;
    }

    .services-closing h2 {
      font-size: 29px;
    }

    .services-closing > .closing-inner > p:not(.eyebrow) {
      font-size: 16px;
    }

    .services-closing .closing-emphasis {
      font-size: 21px;
    }
  }
</style>
