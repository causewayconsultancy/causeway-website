
---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Causeway | Think deeper. Change smarter."
  description="Causeway Decision Quality Consultancy helps organizations navigate complexity, improve decision quality, and move forward with clarity."
>
  <!-- HERO -->

  <section class="hero" id="home">
    <div class="hero-overlay"></div>

    <div class="hero-content">
      <p class="eyebrow">Clarity in complexity</p>
      <h1>Think deeper.<br />Change smarter.</h1>

      <p>
        Better decisions begin with better questions.<br />
        Causeway helps organizations navigate complexity, uncover what matters, and move forward with clarity and confidence.
      </p>

      <a href="/contact" class="cta">Let's start a conversation</a>
    </div>
  </section>

  <!-- INTRODUCTION -->

  <section class="intro section" id="introduction">
    <div class="section-inner">
      <p class="eyebrow">A thoughtful way forward</p>

      <h2>
        Find the cause.<br />
        Find the way.<br />
        Make the decision.
      </h2>

      <p>
        Better decisions start with better understanding the problem
        an organization is actually trying to solve. Through
        disciplined discovery, evidence-informed thinking, and
        thoughtful stakeholder engagement, Causeway helps
        organizations make sense of complexity and move toward
        better outcomes.
      </p>
    </div>
  </section>

  <!-- CONTACT -->

  <section class="contact section" id="contact">
    <div class="section-inner">
      <p class="eyebrow">Start a conversation</p>

      <h2>Have a complex challenge?<br />Let's work through it.</h2>

      <p>
        Whether you're navigating a difficult decision, exploring
        a new direction, or trying to make sense of a complex
        challenge, I'd welcome the conversation.
      </p>

      <a href="mailto:kchapman@causewayconsultancy.ca" class="cta">
        kchapman@causewayconsultancy.ca
      </a>
    </div>
  </section>
</BaseLayout>
