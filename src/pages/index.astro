
---
const services = [
  {
    number: "01",
    title: "Discovery & Problem Definition",
    description: "Getting beneath the surface to understand the real challenge, ask better questions, and identify what matters most.",
    link: "/services/discovery-problem-definition/"
  },
  {
    number: "02",
    title: "Strategic Thinking & Decision Support",
    description: "Bringing structure to complexity, connecting evidence and insight, and helping leaders make thoughtful, informed decisions.",
    link: "/services/strategic-thinking-decision-support/"
  },
  {
    number: "03",
    title: "Facilitation & Stakeholder Engagement",
    description: "Bringing people and perspectives together to build shared understanding and support better decisions.",
    link: "/services/facilitation-stakeholder-engagement/"
  },
  {
    number: "04",
    title: "Change & Implementation",
    description: "Turning insight into action through practical planning, thoughtful change, and sustainable implementation.",
    link: "/services/change-implementation/"
  }
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Causeway Decision Quality Consultancy helps organizations navigate complexity, improve decision quality, and move forward with clarity." />
    <title>Causeway | Think deeper. Change smarter.</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>

  <body>
    <header class="header">
      <a href="/" class="logo">
        <img src="/causeway-logo.png" alt="Causeway Decision Quality Consultancy" />
      </a>

      <nav class="nav-links">
        <a href="/about/">About</a>
        <a href="/thinking/">The Thinking</a>
        <a href="/philosophy/">Philosophy</a>
        <a href="/services/">Services</a>
        <a href="/approach/">How I Work</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main>
      <!-- HERO -->

      <section class="hero" id="home">
        <div class="hero-overlay"></div>

        <div class="hero-content">
          <p class="eyebrow">Clarity in complexity</p>

          <h1>Think deeper.<br />Change smarter.</h1>

          <p>
            Better decisions begin with better questions.
            Causeway helps organizations navigate complexity,
            uncover what matters, and move forward with clarity
            and confidence.
          </p>

          <a href="#contact" class="cta">
            Let's start a conversation
          </a>
        </div>
      </section>

      <!-- INTRODUCTION -->

      <section class="intro section">
        <div class="section-inner">
          <p class="eyebrow">A thoughtful way forward</p>

          <h2>Find the cause.<br />Find the way.</h2>

          <p>
            Better decisions start with understanding the problem
            an organization is actually trying to solve.

            Through disciplined discovery, evidence-informed thinking,
            and thoughtful stakeholder engagement, Causeway helps
            organizations make sense of complexity and find a clearer
            path forward.
          </p>

          <a href="/philosophy/" class="text-link">
            Discover the thinking behind Causeway →
          </a>
        </div>
      </section>

      <!-- ABOUT PREVIEW -->

      <section class="about-preview section">
        <div class="section-inner">
          <p class="eyebrow">The person behind Causeway</p>

          <h2>Experience shaped by people, systems, and the decisions between them.</h2>

          <p>
            Founded by Krista Chapman, Causeway brings together more
            than 15 years of clinical, operational, and senior executive
            leadership experience.
          </p>

          <p>
            A registered nurse, Certified Health Executive (CHE),
            and Master of Precision Health (MPrecH), Krista brings
            a practical understanding of complex organizations and
            a belief that better decisions begin by listening to
            the people most affected by them.
          </p>

          <a href="/about/" class="text-link">
            Get to know Krista →
          </a>
        </div>
      </section>

      <!-- SERVICES PREVIEW -->

      <section class="services section" id="services">
        <div class="section-inner">
          <p class="eyebrow">How Causeway Helps</p>

          <h2>Make sense of the messy.<br />Move toward what matters.</h2>

          <p class="section-intro">
            Every organization faces challenges that require more
            than quick answers. Causeway supports organizations
            through four interconnected areas of work.
          </p>

          <div class="service-grid">
            {services.map((service) => (
              <article class="service">
                <span class="number">{service.number}</span>

                <h3>{service.title}</h3>

                <p>{service.description}</p>

                <a href={service.link} class="text-link">
                  Explore this service →
                </a>
              </article>
            ))}
          </div>

          <div class="services-link">
            <a href="/services/" class="text-link">
              Explore all services →
            </a>
          </div>
        </div>
      </section>

      <!-- APPROACH PREVIEW -->

      <section class="approach section">
        <div class="section-inner">
          <p class="eyebrow">How I Work</p>

          <h2>Comfortable in the grey.<br />Focused on the way forward.</h2>

          <p>
            I bring curiosity, structure, and an open mind to complex
            challenges. I listen carefully, ask thoughtful questions,
            explore different perspectives, and work alongside people
            to uncover what matters.
          </p>

          <p>
            The goal isn't simply to find an answer. It's to make
            better decisions about what comes next.
          </p>

          <a href="/approach/" class="text-link">
            Learn more about how I work →
          </a>
        </div>
      </section>

      <!-- CONTACT -->

      <section class="contact section" id="contact">
        <div class="section-inner">
          <p class="eyebrow">Start a conversation</p>

          <h2>Have a complex challenge?<br />Let's work through it.</h2>

          <p>
            Whether you're navigating a difficult decision,
            exploring a new direction, or trying to make sense
            of a complex challenge, I'd welcome the conversation.
          </p>

          <a href="mailto:kchapman@causewayconsultancy.ca" class="cta">
            Let's talk
          </a>

          <p class="email">
            kchapman@causewayconsultancy.ca
          </p>
        </div>
      </section>
    </main>

    <footer>
      <p>© {new Date().getFullYear()} Causeway Decision Quality Consultancy Inc.</p>
      <p>Think deeper. Change smarter.</p>
    </footer>
  </body>
</html>

<style>
  :root {
    --slate: #23364A;
    --coastal: #668A9A;
    --stone: #C2BBA8;
    --white: #FFFFFF;
    --off-white: #F5F2EA;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    color: var(--slate);
    background: var(--white);
    font-family: "DM Sans", sans-serif;
    line-height: 1.7;
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 7%;
    background: var(--white);
  }

  .logo img {
    display: block;
    width: 190px;
    height: auto;
  }

  .nav-links {
    display: flex;
    gap: 25px;
  }

  .nav-links a {
    color: var(--slate);
    text-decoration: none;
    font-size: 16px;
    font-weight: 700;
    transition: color 0.2s ease;
  }

  .nav-links a:hover {
    color: var(--coastal);
  }

  .hero {
    position: relative;
    min-height: 620px;
    display: flex;
    align-items: center;
    padding: 90px 10%;
    background-image: url("https://images.unsplash.com/photo-1448375240586-882707db888b?auto=format&fit=crop&w=2400&q=85");
    background-size: cover;
    background-position: center;
    color: var(--white);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(24, 42, 55, 0.82),
      rgba(24, 42, 55, 0.35)
    );
  }

  .hero-content {
    position: relative;
    max-width: 720px;
  }

  .eyebrow {
    margin: 0 0 18px;
    color: var(--coastal);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .hero .eyebrow {
    color: var(--white);
  }

  h1,
  h2 {
    margin: 0 0 24px;
    font-family: "Playfair Display", serif;
    font-weight: 400;
    line-height: 1.15;
  }

  h1 {
    font-size: clamp(48px, 6vw, 76px);
  }

  h2 {
    font-size: clamp(38px, 4.5vw, 56px);
  }

  .hero p {
    max-width: 650px;
    margin: 0 0 32px;
    font-size: 19px;
    line-height: 1.8;
  }

  .cta {
    display: inline-block;
    padding: 13px 24px;
    border: 1px solid var(--white);
    color: var(--white);
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    transition: all 0.2s ease;
  }

  .cta:hover {
    background: var(--white);
    color: var(--slate);
  }

  .section {
    padding: 100px 10%;
  }

  .section-inner {
    max-width: 1050px;
    margin: 0 auto;
  }

  .intro {
    background: var(--white);
  }

  .intro p:not(.eyebrow),
  .about-preview p:not(.eyebrow) {
    max-width: 760px;
    font-size: 18px;
    line-height: 1.85;
  }

  .about-preview {
    background: var(--off-white);
  }

  .about-preview h2 {
    max-width: 850px;
  }

  .text-link {
    display: inline-block;
    margin-top: 18px;
    color: var(--coastal);
    text-decoration: none;
    font-size: 15px;
    font-weight: 700;
    transition: color 0.2s ease;
  }

  .text-link:hover {
    color: var(--slate);
  }

  /* Services */

  .services {
    background: var(--white);
  }

  .section-intro {
    max-width: 760px;
    font-size: 18px;
    line-height: 1.85;
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 65px 70px;
    margin-top: 65px;
  }

  .service {
    border-top: 1px solid var(--stone);
    padding-top: 28px;
  }

  .number {
    display: block;
    color: var(--coastal);
    font-family: "Playfair Display", serif;
    font-size: 64px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -2px;
    margin-bottom: 22px;
  }

  .service h3 {
    margin: 0 0 16px;
    font-family: "Playfair Display", serif;
    font-size: 28px;
    font-weight: 400;
    line-height: 1.3;
  }

  .service p {
    max-width: 440px;
    margin: 0;
    font-size: 16px;
    line-height: 1.8;
  }

  .services-link {
    margin-top: 50px;
    padding-top: 25px;
    border-top: 1px solid var(--stone);
  }

  /* Approach */

  .approach {
    background: var(--off-white);
  }

  .approach p:not(.eyebrow) {
    max-width: 760px;
    font-size: 18px;
    line-height: 1.85;
    margin: 0 0 22px;
  }

  /* Contact */

  .contact {
    background: var(--slate);
    color: var(--white);
    text-align: center;
  }

  .contact .eyebrow {
    color: var(--stone);
  }

  .contact p:not(.eyebrow) {
    max-width: 680px;
    margin: 0 auto 30px;
    font-size: 17px;
  }

  .contact .email {
    margin-top: 22px !important;
    font-size: 14px !important;
    color: var(--stone);
  }

  /* Footer */

  footer {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 7%;
    background: #1B2B3B;
    color: var(--white);
    font-size: 13px;
  }

  footer p {
    margin: 0;
  }

  /* Mobile */

  @media (max-width: 900px) {
    .header {
      flex-direction: column;
      gap: 18px;
    }

    .nav-links {
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px 20px;
    }
  }

  @media (max-width: 700px) {
    .header {
      padding: 20px;
    }

    .logo img {
      width: 165px;
    }

    .nav-links a {
      font-size: 14px;
    }

    .hero {
      min-height: 560px;
      padding: 70px 8%;
      background-position: center;
    }

    .hero p {
      font-size: 17px;
    }

    .section {
      padding: 70px 8%;
    }

    .intro p:not(.eyebrow),
    .about-preview p:not(.eyebrow),
    .approach p:not(.eyebrow) {
      font-size: 16px;
    }

    .service-grid {
      grid-template-columns: 1fr;
      gap: 48px;
      margin-top: 50px;
    }

    .number {
      font-size: 56px;
      margin-bottom: 18px;
    }

    .service h3 {
      font-size: 26px;
    }

    .service p {
      font-size: 15px;
    }

    footer {
      flex-direction: column;
      text-align: center;
      padding: 22px;
    }
  }
</style>
